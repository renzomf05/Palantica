              "mode": "raw",
              "raw": "{\n  \"durezaPercibida\": 7,\n  \"potencia\": 9,\n  \"control\": 9,\n  \"salidaBola\": 8,\n  \"maniobrabilidad\": 9,\n  \"puntoDulce\": 9,\n  \"confort\": 8,\n  \"estacionRecomendada\": \"TodoAno\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/palas/1/votos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "palas", "1", "votos"]
            }
          }
        }
      ]
